# For GitHub Pages project site. For a custom domain, use "/" as base path.
NEXT_PUBLIC_BASE_PATH=/glanzberg-web
NEXT_PUBLIC_SITE_URL=https://glanzberg-web.github.io/glanzberg-web

# Public URL to the separately deployed Resend proxy endpoint.
# Leave blank to keep the form disabled until tested.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Never place RESEND_API_KEY here. It belongs only in the private Worker secrets.
