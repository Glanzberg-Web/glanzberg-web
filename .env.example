# Canonical website URL including https:// (set when domain is finalized).
NEXT_PUBLIC_SITE_URL=

# Resend key for server-side sending. Never use NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# Inbox that receives project inquiries.
CONTACT_TO_EMAIL=

# Verified sending address on a domain authenticated in Resend.
CONTACT_FROM_EMAIL=
